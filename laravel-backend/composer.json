{
    "name": "mocu/fleet-management-system",
    "type": "project",
    "description": "Moshi Co-operative University (MoCU) Fleet Fuel and Vehicle Management System - Laravel REST API with Sanctum & MongoDB",
    "keywords": ["laravel", "sanctum", "mongodb", "fleet-management", "fuel-tracking", "mocu", "tanzania"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0",
        "laravel/sanctum": "^4.0",
        "mongodb/laravel-mongodb": "^4.0",
        "barryvdh/laravel-dompdf": "^2.1",
        "maatwebsite/excel": "^3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
